# Template for .env.production and .env.local. COMMITTED to git.
# Copy this to .env.production (VPS) or .env.local (docker-compose) and fill values.
# Both .env.production and .env.local are gitignored; .env.example is not.

# ---- Required ----

# Where the Twenty server lives. Examples:
#   .env.local       → http://localhost:4440
#   .env.production  → http://<vps-host>
TWENTY_BASE_URL=

# Workspace API key. Generate from Twenty UI: Settings → Developers → API Keys.
# Use a different key per env. The local key MUST come from the local stack;
# DO NOT paste a VPS key into .env.local (the destructive sweep would write to prod).
TWENTY_API_KEY=

# ---- Optional ----

# Required only for .env.production when the deployed proxy sits behind a
# Caddy / reverse-proxy gate that enforces an inbound bearer token.
# Leave unset for .env.local (the local proxy has no inbound auth).
MCP_INBOUND_TOKEN=

# Bind address + port for running the proxy from source via `node lib/index.js`.
# Useful only in .env.local; the deployed proxy reads its own env via docker-compose.
MCP_BIND=127.0.0.1
MCP_PORT=4441
