TAG=latest

#PG_DATABASE_USER=postgres
#PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
#PG_DATABASE_HOST=db
#PG_DATABASE_PORT=5432
#REDIS_URL=redis://redis:6379

SERVER_URL=http://localhost:3000

# When true, the backend stops injecting REACT_APP_SERVER_BASE_URL into index.html
# and the frontend resolves the API origin from the page's own hostname at request
# time. Set to true on the VPS so the deploy is reachable both at SERVER_URL and
# at http://localhost from inside the host without a hairpin.
# FRONT_AUTO_BASE_URL=true

# Use openssl rand -base64 32 for each secret
# APP_SECRET=replace_me_with_a_random_string

STORAGE_TYPE=local

# Host IP that Caddy publishes port 80 on (docker-compose.deploy.yml).
# Defaults to 127.0.0.1. Set it to a private/tailnet address for LAN or tailnet
# access. Do NOT set 0.0.0.0 unless you have TLS and a host matcher in the
# Caddyfile — the default site block answers any Host header, so publishing on
# all interfaces serves the UI and the GraphQL API to the internet over
# plaintext HTTP.
# CADDY_BIND_IP=127.0.0.1

# STORAGE_S3_REGION=eu-west3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# MCP server (used by docker-compose.deploy.yml).
# TWENTY_API_KEY: workspace API key generated in the Twenty UI.
# MCP_INBOUND_TOKEN: bearer token Caddy requires on POST /mcp. Generate with:
#   openssl rand -hex 32
# TWENTY_MCP_ENABLE_METADATA: set to "true" to expose the metadata_* tool family
#   (metadata_query, metadata_create_object, metadata_create_field,
#   metadata_create_relation, metadata_apply_plan). Required for the
#   crm-administration sub-agent pod; harmless to leave unset for CRM-only use.
# TWENTY_API_KEY=
# MCP_INBOUND_TOKEN=
# MCP_PORT=4441
# TWENTY_MCP_ENABLE_METADATA=true
